    "db:reset": "bun src/db/scripts/reset.ts",
    "db:seed": "bun src/db/scripts/seed.ts"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "dayjs": "^1.11.13",
    "node-cron": "^3.0.3",
    "puppeteer": "^23.9.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
