{
  "name": "instagram-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun run db:migrate && NODE_ENV=production bun src/index.ts",
    "lint": "eslint src/ frontend/",
    "lint:fix": "eslint src/ frontend/ --fix",
    "format": "prettier --write src/ frontend/",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/db/scripts/migrate.ts",
    "db:reset": "bun src/db/scripts/reset.ts",
    "db:seed": "bun src/db/scripts/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-table": "^8.21.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.13",
    "lucide-react": "^1.16.0",
    "node-cron": "^3.0.3",
    "pino": "^10.3.1",
    "puppeteer": "^23.9.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.76.0",
    "react-router-dom": "^7.15.1",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node-cron": "^3.0.11",
    "@types/pino": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-router-dom": "^5.3.3",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  }
}
